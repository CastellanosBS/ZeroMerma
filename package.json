{
  "name": "zeromerma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "contracts:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contracts/generate-api-client.ps1",
    "dev:backoffice": "corepack pnpm --filter @zeromerma/backoffice-web dev",
    "dev:pos": "corepack pnpm --filter @zeromerma/pos-web dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "foundation:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/check-foundation.ps1",
    "lint": "corepack pnpm -r --if-present lint",
    "test:operational-regression": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/run-operational-regression.ps1",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm -r --if-present test:e2e",
    "toolchain:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/check-toolchain.ps1",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
