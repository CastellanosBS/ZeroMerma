ZEROMERMA_API_ENVIRONMENT=local
ZEROMERMA_API_DATABASE_URL=postgresql+psycopg://zeromerma:zeromerma@localhost:5432/zeromerma
ZEROMERMA_API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
ZEROMERMA_API_SESSION_POS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ZEROMERMA_API_SESSION_BACKOFFICE_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
ZEROMERMA_API_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","testserver"]
ZEROMERMA_API_TRUSTED_PROXY_IPS=[]
ZEROMERMA_API_SESSION_COOKIE_SAMESITE=lax
ZEROMERMA_API_ENABLE_API_DOCS=false
ZEROMERMA_API_AUTH_LOGIN_WINDOW_SECONDS=900
ZEROMERMA_API_AUTH_LOGIN_ACCOUNT_LIMIT=10
ZEROMERMA_API_AUTH_LOGIN_IP_LIMIT=50
ZEROMERMA_API_AUTH_LOGIN_BLOCK_SECONDS=900
ZEROMERMA_API_PASSWORD_RESET_TTL_MINUTES=30
ZEROMERMA_API_TRAINING_MODE_ENABLED=false
ZEROMERMA_API_TRAINING_MODE_LABEL=Modo entrenamiento
ZEROMERMA_API_ENABLE_DEV_AUDIT_ENDPOINT=false
# Development audit credentials must be separately generated when explicitly enabled.
ZEROMERMA_API_WASTE_HIGH_IMPACT_QUANTITY_THRESHOLD=10
ZEROMERMA_API_CORRECTION_HIGH_IMPACT_QUANTITY_THRESHOLD=10
ZEROMERMA_API_DISCOUNT_HIGH_VALUE_AMOUNT_THRESHOLD=200
ZEROMERMA_API_RETURN_HIGH_REFUND_AMOUNT_THRESHOLD=200
ZEROMERMA_API_RETURN_OLD_SALE_DAYS_THRESHOLD=7

VITE_API_BASE_URL=http://localhost:8000
VITE_POS_WORKSTATION_CODE=POS-01
VITE_BACKOFFICE_BASE_URL=http://localhost:5174
VITE_POS_BASE_URL=http://localhost:5173

ZEROMERMA_WORKER_ENVIRONMENT=local
ZEROMERMA_WORKER_DATABASE_URL=postgresql+psycopg://zeromerma:zeromerma@localhost:5432/zeromerma
ZEROMERMA_WORKER_POLL_INTERVAL_SECONDS=5
ZEROMERMA_WORKER_BATCH_SIZE=25
ZEROMERMA_WORKER_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# The credentials above are local demo values and are rejected in staging/production.
# Deployment uses injected environment or private runtime files, never both sources.
# ZEROMERMA_API_DATABASE_URL_FILE=/private/runtime/api-database-url
# ZEROMERMA_WORKER_DATABASE_URL_FILE=/private/runtime/worker-database-url
# Explicit HTTPS application origins, API hosts and trusted proxy IPs are required.
# Session cookies remain Secure in development; use the isolated HTTPS browser harness.
