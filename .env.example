ZEROMERMA_API_ENVIRONMENT=local
ZEROMERMA_API_DATABASE_URL=postgresql+psycopg://zeromerma:zeromerma@localhost:5432/zeromerma
ZEROMERMA_API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
ZEROMERMA_API_AUTH_TOKEN_SECRET=zeromerma-local-development-token-secret
ZEROMERMA_API_AUTH_TOKEN_TTL_MINUTES=480
ZEROMERMA_API_TRAINING_MODE_ENABLED=false
ZEROMERMA_API_TRAINING_MODE_LABEL=Modo entrenamiento
ZEROMERMA_API_ENABLE_DEV_AUDIT_ENDPOINT=false
ZEROMERMA_API_DEV_AUDIT_TOKEN=change-me-dev-audit-token
ZEROMERMA_API_WASTE_HIGH_IMPACT_QUANTITY_THRESHOLD=10
ZEROMERMA_API_CORRECTION_HIGH_IMPACT_QUANTITY_THRESHOLD=10
ZEROMERMA_API_DISCOUNT_HIGH_VALUE_AMOUNT_THRESHOLD=200
ZEROMERMA_API_RETURN_HIGH_REFUND_AMOUNT_THRESHOLD=200
ZEROMERMA_API_RETURN_OLD_SALE_DAYS_THRESHOLD=7

ZEROMERMA_WORKER_ENVIRONMENT=local
ZEROMERMA_WORKER_DATABASE_URL=postgresql+psycopg://zeromerma:zeromerma@localhost:5432/zeromerma
ZEROMERMA_WORKER_POLL_INTERVAL_SECONDS=5
ZEROMERMA_WORKER_BATCH_SIZE=25
